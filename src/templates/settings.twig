{% import '_includes/forms' as forms %}
{% set sectionsService = craft.app.entries %}
{% set allSections = sectionsService.getAllSections() %}

{% block content %}

<div class="field first">
  {{ forms.lightswitchField({
    label: 'Enable Marked Down'|t('marked-down'),
    name: 'enabled',
    id: 'enabled',
    on: settings.enabled,
    instructions: 'Master switch. When off, no Markdown is ever served.'|t('marked-down'),
  }) }}
</div>

<hr />

<h2>{{ 'Sections'|t('marked-down') }}</h2>
<p class="light">{{ 'Per-section settings. Stored in project config so they sync across environments.'|t('marked-down') }}</p>

{% if allSections|length == 0 %}
  <p>{{ 'No sections defined yet.'|t('marked-down') }}</p>
{% else %}
  <table class="data fullwidth">
    <thead>
      <tr>
        <th scope="col">{{ 'Section'|t('marked-down') }}</th>
        <th scope="col">{{ 'Markdown'|t('marked-down') }}</th>
        <th scope="col">{{ 'AI bots only'|t('marked-down') }}</th>
        <th scope="col">{{ 'Front matter'|t('marked-down') }}</th>
        <th scope="col">{{ 'Dedicated template'|t('marked-down') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for section in allSections %}
        {% set cfg = settings.getSectionSettings(section.uid) %}
        {% set fieldBase = 'sectionSettings[' ~ section.uid ~ ']' %}
        <tr>
          <th scope="row">
            <strong>{{ section.name }}</strong><br />
            <code class="light">{{ section.handle }}</code>
          </th>
          <td>
            {{ forms.lightswitch({
              name: fieldBase ~ '[enabled]',
              on: cfg.enabled,
            }) }}
          </td>
          <td>
            {{ forms.lightswitch({
              name: fieldBase ~ '[aiOnly]',
              on: cfg.aiOnly,
            }) }}
          </td>
          <td>
            {{ forms.lightswitch({
              name: fieldBase ~ '[includeFrontMatter]',
              on: cfg.includeFrontMatter,
            }) }}
          </td>
          <td>
            {{ forms.text({
              name: fieldBase ~ '[dedicatedTemplate]',
              value: cfg.dedicatedTemplate,
              placeholder: section.handle ~ '/_entry.md',
              size: 30,
            }) }}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

<hr />

<h2>{{ 'Detection'|t('marked-down') }}</h2>

<div class="field">
  {{ forms.textareaField({
    label: 'AI bot User-Agent patterns'|t('marked-down'),
    name: 'aiBotPatterns',
    id: 'aiBotPatterns',
    value: settings.getAiBotPatternsString(),
    rows: 6,
    instructions: 'One substring per line, case-insensitive. Requests whose User-Agent contains any of these get Markdown automatically.'|t('marked-down'),
  }) }}
</div>

<hr />

<h2>{{ 'Paths'|t('marked-down') }}</h2>

<div class="field">
  {{ forms.textareaField({
    label: 'Excluded paths'|t('marked-down'),
    name: 'excludePaths',
    id: 'excludePaths',
    value: settings.getExcludePathsString(),
    rows: 5,
    instructions: 'One path per line. Always served as HTML. Wildcard suffix supported, e.g. /actions/*.'|t('marked-down'),
  }) }}
</div>

<div class="field">
  {{ forms.textareaField({
    label: 'Include-only paths (optional)'|t('marked-down'),
    name: 'includeOnlyPaths',
    id: 'includeOnlyPaths',
    value: settings.getIncludeOnlyPathsString(),
    rows: 5,
    instructions: 'Leave empty to allow all paths (except excluded ones). If set, only these paths can serve Markdown.'|t('marked-down'),
  }) }}
</div>

<hr />

<h2>{{ 'Discovery'|t('marked-down') }}</h2>

<div class="field">
  {{ forms.lightswitchField({
    label: 'Inject <link rel="alternate" type="text/markdown"> into HTML'|t('marked-down'),
    name: 'injectDiscoveryLink',
    id: 'injectDiscoveryLink',
    on: settings.injectDiscoveryLink,
  }) }}
</div>

<div class="field">
  {{ forms.lightswitchField({
    label: 'Send X-Robots-Tag: noindex on Markdown responses'|t('marked-down'),
    name: 'noIndexMarkdown',
    id: 'noIndexMarkdown',
    on: settings.noIndexMarkdown,
  }) }}
</div>

<hr />

<h2>{{ 'llms.txt'|t('marked-down') }}</h2>

<div class="field">
  {{ forms.lightswitchField({
    label: 'Expose /llms.txt'|t('marked-down'),
    name: 'llmsTxtEnabled',
    id: 'llmsTxtEnabled',
    on: settings.llmsTxtEnabled,
  }) }}
</div>

<div class="field">
  {{ forms.textField({
    label: 'Entries per section in /llms.txt'|t('marked-down'),
    name: 'llmsTxtEntriesPerSection',
    id: 'llmsTxtEntriesPerSection',
    value: settings.llmsTxtEntriesPerSection,
    type: 'number',
    min: 0,
  }) }}
</div>

<h3>{{ 'Title and summary per site'|t('marked-down') }}</h3>
<p class="light">{{ 'The title is the H1 of /llms.txt and defaults to the site name. The summary is the optional blockquote below it.'|t('marked-down') }}</p>

<table class="data fullwidth">
  <thead>
    <tr>
      <th scope="col">{{ 'Site'|t('marked-down') }}</th>
      <th scope="col">{{ 'Title'|t('marked-down') }}</th>
      <th scope="col">{{ 'Summary'|t('marked-down') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for site in craft.app.sites.allSites %}
      <tr>
        <th scope="row">
          <strong>{{ site.name }}</strong><br />
          <code class="light">{{ site.handle }}</code>
        </th>
        <td>
          {{ forms.text({
            name: 'llmsTxtTitle[' ~ site.handle ~ ']',
            value: settings.llmsTxtTitle[site.handle] ?? '',
            placeholder: site.name,
            size: 30,
          }) }}
        </td>
        <td>
          {{ forms.text({
            name: 'llmsTxtSummary[' ~ site.handle ~ ']',
            value: settings.llmsTxtSummary[site.handle] ?? '',
            size: 50,
          }) }}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<hr />

<h2>{{ 'Caching'|t('marked-down') }}</h2>

<div class="field">
  {{ forms.lightswitchField({
    label: 'Enable caching'|t('marked-down'),
    name: 'enableCache',
    id: 'enableCache',
    on: settings.enableCache,
  }) }}
</div>

<div class="field">
  {{ forms.textField({
    label: 'Cache duration (seconds)'|t('marked-down'),
    name: 'cacheDuration',
    id: 'cacheDuration',
    value: settings.cacheDuration,
    type: 'number',
    min: 0,
    instructions: 'Default: 86400 (24 hours).'|t('marked-down'),
  }) }}
</div>

{% endblock %}
